# camera_gizmo.obj — LibraryV3
# Frustum canonique de visualisation de camera.
#
# CONVENTION : main droite, Y up, regard vers -Z.
#   apex     : (0, 0, 0)          -> position de l'oeil
#   quad far : z = -1, demi-extensions (1, 1)
#
# La forme reelle est obtenue par une matrice de SCALE appliquee
# au TransformComponent local du gizmo :
#     Sx = length * tan(fovY/2) * aspect
#     Sy = length * tan(fovY/2)
#     Sz = length
#
# Winding : CCW vu de l'EXTERIEUR. Triangles uniquement
# (MeshClass::vertsPerFace est unique pour tout le mesh : pas de quad).

o CameraGizmo

# ---- sommets ----
v  0.0  0.0  0.0     # 1 : apex
v -1.0 -1.0 -1.0     # 2 : far bas-gauche
v  1.0 -1.0 -1.0     # 3 : far bas-droit
v  1.0  1.0 -1.0     # 4 : far haut-droit
v -1.0  1.0 -1.0     # 5 : far haut-gauche

# ---- normales ----
vn  0.000000 -0.707107  0.707107   # 1 : face basse
vn  0.707107  0.000000  0.707107   # 2 : face droite
vn  0.000000  0.707107  0.707107   # 3 : face haute
vn -0.707107  0.000000  0.707107   # 4 : face gauche
vn  0.000000  0.000000 -1.000000   # 5 : quad far

# ---- faces laterales (apex -> far) ----
f 1//1 2//1 3//1
f 1//2 3//2 4//2
f 1//3 4//3 5//3
f 1//4 5//4 2//4

# ---- quad far, triangule ----
f 5//5 4//5 3//5
f 5//5 3//5 2//5
