# camera_gizmo_box.obj — LibraryV3
# Volume de vue canonique d'une camera ORTHOGRAPHIQUE.
#
# CONVENTION (identique a camera_gizmo.obj) :
#   main droite, Y up, regard vers -Z
#   face avant   : z =  0
#   face arriere : z = -1
#   demi-extensions : 1 x 1  (section CONSTANTE)
#
# Forme reelle obtenue par SCALE sur le TransformComponent local :
#     Sx = (orthoHeight / 2) * aspect     <- INDEPENDANT de length
#     Sy = (orthoHeight / 2)              <- INDEPENDANT de length
#     Sz = length
#
# Winding : CCW vu de l'EXTERIEUR. Triangles uniquement.
# vertsPerFace = 3   |   faceCount() = 14   |   11 sommets, 6 normales

o CameraGizmoBox

# ---- face avant (z = 0) ----
v -1.0 -1.0  0.0     # 1
v  1.0 -1.0  0.0     # 2
v  1.0  1.0  0.0     # 3
v -1.0  1.0  0.0     # 4
# ---- face arriere (z = -1) ----
v -1.0 -1.0 -1.0     # 5
v  1.0 -1.0 -1.0     # 6
v  1.0  1.0 -1.0     # 7
v -1.0  1.0 -1.0     # 8
# ---- sommets du marqueur "up" ----
v -0.35  1.05 -1.0   # 9
v  0.35  1.05 -1.0   # 10
v  0.00  1.60 -1.0   # 11

# ---- normales ----
vn  0.0  0.0  1.0    # 1 : +Z  avant  + marqueur verso
vn  0.0  0.0 -1.0    # 2 : -Z  arriere + marqueur recto
vn  1.0  0.0  0.0    # 3 : +X  droite
vn -1.0  0.0  0.0    # 4 : -X  gauche
vn  0.0  1.0  0.0    # 5 : +Y  haut
vn  0.0 -1.0  0.0    # 6 : -Y  bas

# ---- avant (+Z) ----
f 1//1 2//1 3//1
f 1//1 3//1 4//1
# ---- arriere (-Z) ----
f 8//2 7//2 6//2
f 8//2 6//2 5//2
# ---- droite (+X) ----
f 2//3 6//3 7//3
f 2//3 7//3 3//3
# ---- gauche (-X) ----
f 1//4 4//4 8//4
f 1//4 8//4 5//4
# ---- haut (+Y) ----
f 4//5 3//5 7//5
f 4//5 7//5 8//5
# ---- bas (-Y) ----
f 1//6 5//6 6//6
f 1//6 6//6 2//6

# ---- marqueur "up" : revele le roll, double face ----
f  9//2 10//2 11//2
f 11//1 10//1  9//1
