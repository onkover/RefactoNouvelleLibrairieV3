<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ============================================================
       MODELE. Copier en LV3.User.props (NON versionne) et adapter
       les chemins a la machine locale.

       C'est le SEUL fichier du projet autorise a contenir un chemin
       absolu. Aucun autre .vcxproj, .props ou .json n'en contient.
       ============================================================ -->

  <PropertyGroup Label="UserMacros">
    <SDL2_DIR>C:\chemin\vers\SDL2-2.26.2</SDL2_DIR>
    <SDL2_TTF_DIR>C:\chemin\vers\SDL2_ttf-2.0.14</SDL2_TTF_DIR>
    <LIBRARYV3_DIR>C:\chemin\vers\LibraryV3</LIBRARYV3_DIR>
  </PropertyGroup>

</Project>