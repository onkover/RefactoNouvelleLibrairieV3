<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ============================================================
       LV3.Common.props — reglages de compilation communs a
       LibraryV3 (LIB) et RefactoNouvelleLibrairieV3 (EXE).

       UN SEUL FOYER : toute divergence entre Debug et Release sur
       ces reglages a produit un bug (bug 12, ANSI ; expected en
       C++20 ; _clock masque non signale faute de Level4).

       Ne contient AUCUN chemin de machine : voir LV3.User.props.
       ============================================================ -->

  <PropertyGroup>
    <!-- Temoin lu par la cible de garde des .vcxproj : si ce fichier
         n'est pas charge, le build s'arrete au lieu de compiler avec
         les reglages par defaut. -->
    <LV3CommonPropsLoaded>true</LV3CommonPropsLoaded>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>

      <!-- C++23 : std::expected (ResourceManager::LoadMeshChecked, F5). -->
      <LanguageStandard>stdcpp23</LanguageStandard>

      <!-- /permissive- : conformite stricte. -->
      <ConformanceMode>true</ConformanceMode>

      <!-- Level4 dans TOUTES les configurations. -->
      <WarningLevel>Level4</WarningLevel>

      <!-- Compilation parallele. -->
      <MultiProcessorCompilation>true</MultiProcessorCompilation>

      <!-- /utf-8          : sources et litteraux en UTF-8 (bug 12).
           /Zc:__cplusplus : __cplusplus rapporte le vrai mode standard.
                             Aucune case dans l'IDE : se pose ici.
           /we4456 : declaration masque une variable locale
           /we4457 : declaration masque un parametre de fonction
           /we4458 : declaration masque un membre de classe
           /we4459 : declaration masque une variable globale  <- bug 52
           /we4553 : expression sans effet                    <- bug 23
           /we4700 : variable locale non initialisee utilisee
           /we4701 : variable locale potentiellement non initialisee <- bug 60
           /we4715 : chemin de sortie sans valeur de retour -->
      <AdditionalOptions>/utf-8 /Zc:__cplusplus /we4456 /we4457 /we4458 /we4459 /we4553 /we4700 /we4701 /we4715 %(AdditionalOptions)</AdditionalOptions>

    </ClCompile>
  </ItemDefinitionGroup>
	<!-- ============================================================
       RelWithAsserts : LV3_ASSERTS_ENABLED defini UNE SEULE FOIS,
       pour la LIB et l'EXE a la fois — sinon exactement le bug
       de fond que ce fichier existe pour eviter (cf. en-tete).
       Condition sur $(Configuration) seul : vaut pour Win32 et x64.
       ============================================================ -->
	<ItemDefinitionGroup Condition="'$(Configuration)'=='RelWithAsserts'">
		<ClCompile>
			<PreprocessorDefinitions>LV3_ASSERTS_ENABLED=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ClCompile>
	</ItemDefinitionGroup>

	<!-- ============================================================
       Phase G : harnais de mesure. UN SEUL MOT a changer ici pour
       armer la campagne, et il vaut pour la LIB et pour l'EXE
       jamais deux definitions independantes (bug 0.3).
       Alternative sans editer ce fichier :
         msbuild ... /p:LV3Profile=true
       Remettre a false une fois la campagne close : une binaire
       livree ne doit porter aucune borne de mesure.
       ============================================================ -->
	<PropertyGroup>
		<LV3Profile Condition="'$(LV3Profile)'==''">true</LV3Profile>
	</PropertyGroup>
	<ItemDefinitionGroup Condition="'$(LV3Profile)'=='true'">
		<ClCompile>
			<PreprocessorDefinitions>LV3_PROFILE=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ClCompile>
	</ItemDefinitionGroup>

	<!-- La valeur EFFECTIVE de LV3Profile, affichee a chaque compilation, pour
       les deux projets. $(LV3Profile) peut venir de trois sources : ce fichier,
       une variable d'ENVIRONNEMENT (MSBuild en fait une propriete), ou un
       /p:LV3Profile=... en ligne de commande. Les trois sont legitimes ; ce qui
       ne l'est pas, c'est de ne pas savoir laquelle a gagne. -->
	<Target Name="LV3ShowProfile" BeforeTargets="ClCompile">
		<Message Importance="high"
		         Text="[LV3] $(MSBuildProjectName) | $(Configuration)|$(Platform) | LV3Profile=$(LV3Profile)" />
	</Target>
</Project>