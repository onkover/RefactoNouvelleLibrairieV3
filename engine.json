{
  "_comment": "LibraryV3 — Configuration moteur (engine.json)",
  "_version": "1.0.0",

  "renderer": {
    "rasterizer": true,
    "raycaster": false,
    "tile_size": 64,
    "max_bounces": 10,
    "shadow_bias": 0.0001,
    "alpha_thresh": 0.5,
    "multithread": true
  },

  "features": {
    "shadows": true,
    "fog": false,
    "wireframe": false,
    "stats": true,
    "raycast": true
  },

  "resources": {
    "assets": "/assets/",
    "mesh": "/assets/meshes/",
    "scene": "/assets/graphscene/",
    "graph": "/assets/graphs/"
  },
  "simulationclock": {
    "timeScale": 0.20,
    "simTime": 0.20,
    "step": 1.5,
    "sprint": 4.0,
    "min": 0.001,
    "max": 1000.0
  },
  "debug": { "depthDisplayRange": 80.0 }
}